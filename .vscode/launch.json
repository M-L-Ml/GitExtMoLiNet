{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
      {
        "name": "C#: GitExtensions Debug",
        "type": "dotnet",
        "request": "launch",
        "projectPath": "${workspaceFolder}/src/app/GitExtensions/GitExtensions.csproj"
      },
      {
        "name": "C#: GitExtensions WSL Debug",
        "type": "dotnet",
        "request": "launch",
        "projectPath": "${workspaceFolder}/src/app/GitExtensions/GitExtensions.csproj",
        "pipeTransport": {
          "pipeCwd": "${workspaceFolder}",
          "pipeProgram": "wsl",
          "pipeArgs": [],
          "debuggerPath": "/usr/bin/dotnet"
        },
        "sourceFileMap": {
          "/mnt/c": "c:\\"
        }
      },


        {
            "name": "Debug",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/artifacts/Debug/bin/GitExtensions/net9.0/GitExtensions.dll",
            "args": ["browse", "${workspaceFolder}"],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "console": "internalConsole"
        },
        {
            "name": "Debug - d w",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/artifacts/Debug/bin/GitExtensions/net9.0-windows/GitExtensions.exe",
            "args": [],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "console": "internalConsole"
        },
        {
          "name": "C#: GitExtensions DevContainer Debug",
          "type": "coreclr",
          "request": "launch",
          // "preLaunchTask": "build",
          "program": "/workspace/artifacts/Debug/bin/GitExtensions/net9.0/GitExtensions.dll",
          "args": ["browse", "/workspace"],
          "cwd": "/workspace",
          "pipeTransport": {
            "pipeProgram": "docker",
            "pipeArgs": ["exec", "-i", "${input:containerName}"],
            "debuggerPath": "/usr/share/dotnet/dotnet",
            "pipeCwd": "${workspaceFolder}"
          },
          "env": {
            "ASPNETCORE_ENVIRONMENT": "Development"
          },
          "stopAtEntry": false,
          "console": "internalConsole",
          "sourceFileMap": {
            "/workspace": "${workspaceFolder}"
          }
        },
        {
          "name": "C#: GitExtensions DevContainer Debug (Simple)",
          "type": "coreclr",
          "request": "launch",
          "preLaunchTask": "build",
          "program": "/workspace/artifacts/Debug/bin/GitExtensions/net9.0/GitExtensions.dll",
          "args": ["browse", "/workspace"],
          "cwd": "/workspace",
          "stopAtEntry": false,
          "console": "internalConsole"
        }
    ],
    "inputs": [
      {
        "id": "containerName",
        "type": "promptString",
        "description": "Enter the name of the running devcontainer (use 'docker ps' to list)"
      }
    ]
}