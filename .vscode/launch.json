    "version": "0.2.0",
    "configurations": [
      {
        "name": "C#: GitExtensions Debug",
        "type": "dotnet",
        "request": "launch",
        "projectPath": "${workspaceFolder}/src/app/GitExtensions/GitExtensions.csproj"
      },
      {
        "name": "C#: GitExtensions WSL Debug",
        "type": "dotnet",
        "request": "launch",
        "projectPath": "${workspaceFolder}/src/app/GitExtensions/GitExtensions.csproj",
        "pipeTransport": {
          "pipeCwd": "${workspaceFolder}",
          "pipeProgram": "wsl",
          "pipeArgs": [],
          "debuggerPath": "/usr/bin/dotnet"
        },
        "sourceFileMap": {
          "/mnt/c": "c:\\"
        }
      },


        {
            "name": "Debug",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/artifacts/Debug/bin/GitExtensions/net9.0-windows/GitExtensions.exe",
            "args": ["browse", "${workspaceFolder}"],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "console": "internalConsole"
        },
        {
            "name": "Debug - d w",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/artifacts/Debug/bin/GitExtensions/net9.0-windows/GitExtensions.exe",
            "args": [],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "console": "internalConsole"
        },
    ]
}