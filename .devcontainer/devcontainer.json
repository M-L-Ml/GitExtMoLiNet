{
  "name": "GitExtensions .NET 9.0 DevContainer",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace/gitext_wt3,type=bind,consistency=cached",
  "workspaceFolder": "/workspace/gitext_wt3",
  "mounts": [
    "source=gitext_vol,target=/workspace/gitext_wtl,type=volume",
    "source=${localWorkspaceFolder}\\..\\gitextensions,target=/workspace/gitextensions,type=bind,consistency=cached",
    "source=C:\\Progs\\Symbol_Cache,target=/workspace/symbols_cache,type=bind,consistency=cached",
    "source=nuget-packages1,target=/root/.nuget/packages,type=volume",
    "source=lin_symbolcache,target=/root/.dotnet/symbolcache/,type=volume"
  ],	
  // Configure tool-specific properties.
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "dotnet.completion.showCompletionItemsFromUnimportedNamespaces": true,
        "omnisharp.enableEditorConfigSupport": true,
        "omnisharp.enableRoslynAnalyzers": true
      },
      "extensions": [
        "ms-dotnettools.csharp",
        "ms-dotnettools.vscode-dotnet-runtime",
        "ms-vscode.vscode-json",
        "editorconfig.editorconfig",
        "ms-vscode.powershell"
      ]
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/georgofenbeck/features/lazygit-linuxbinary": {},
    "ghcr.io/devcontainers-extra/features/fzf": {},
    "ghcr.io/devcontainers/features/powershell": {},
    "ghcr.io/devcontainer-community/devcontainer-features/btop": {},
    "ghcr.io/devcontainers-extra/features/apt-get-packages": {
      "packages": [
        "aptitude",
        "less"
      ]
    }
  },
    
  // Use 'postCreateCommand' to run commands after the container is created.
  // "postCreateCommand": "dotnet restore",
  "postCreateCommand": " dotnet --info ; echo Hello devcontainerId ${devcontainerId}, containerWorkspaceFolder ${containerWorkspaceFolder}, containerWorkspaceFolderBasename ${containerWorkspaceFolderBasename}, localEnv:USERNAME ${localEnv:USERNAME} ; fzf --bash >> ~/.bashrc; dotnet restore ; echo $?",
  //  to connect as root  . More info: https://aka.ms/dev-containers-non-root.
  "remoteUser": "root"
  
  // Use 'forwardPorts' to make a list of ports inside the container available locally.
  // "forwardPorts": [5000, 5001],
  // "portsAttributes": {
  //		"5001": {
  //			"protocol": "https"
  //		}
  // }

}
